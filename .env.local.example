# Supabase — from your project's Settings > API page (or `supabase status` if running locally)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser. Used for admin/service-role tasks
# (e.g. seeding knowledge_base, generating signed URLs for exports).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM provider for the blueprint agent (Phase 2)
ANTHROPIC_API_KEY=your-anthropic-api-key
